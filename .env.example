# --- Runtime ---------------------------------------------------------------
# both | poll-only | api-only
APP_MODE=both
APP_HOST=0.0.0.0
APP_PORT=8080
# Shared secret for POST /api/alarm and /api/close (Authorization: Bearer <token>)
APP_API_TOKEN=change-me

# --- Jira Cloud --------------------------------------------------------------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=integration-user@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SOC
JIRA_ISSUE_TYPE=Task
JIRA_DEFAULT_LABELS=soc-alert
JIRA_REQUEST_TIMEOUT=20
# Empty = every issue of JIRA_PROJECT_KEY ordered by last update
JIRA_JQL_FILTER=

# --- IBM QRadar SOAR -----------------------------------------------------------
SOAR_HOST=soar.example.com
SOAR_PORT=443
SOAR_ORG=Example Organization
SOAR_API_KEY_ID=your-soar-api-key-id
SOAR_API_KEY_SECRET=your-soar-api-key-secret
# CA bundle path, or "false" to skip verification for self-signed lab instances
SOAR_CAFILE=
# Incident custom fields that hold the Jira key (the first one is written to)
SOAR_JIRA_FIELD_NAMES=jira_key,jira_issue_key

# --- Notification mailbox (IMAP) ---------------------------------------------------
MAIL_IMAP_HOST=outlook.office365.com
MAIL_IMAP_PORT=993
MAIL_USE_SSL=true
MAIL_USERNAME=soc-notify@example.com
# password | oauth2
MAIL_AUTH_METHOD=oauth2
MAIL_PASSWORD=
MAIL_OAUTH_TENANT_ID=your-tenant-id
MAIL_OAUTH_CLIENT_ID=your-app-client-id
MAIL_OAUTH_CLIENT_SECRET=your-app-client-secret
MAIL_OAUTH_REFRESH_TOKEN=your-refresh-token
MAIL_FOLDER=INBOX
MAIL_PROCESSED_FOLDER=Processed
MAIL_JIRA_KEY_PATTERN=[A-Z][A-Z0-9]+-\d+
MAIL_CLOSURE_KEYWORDS=closed,resolved
# Only mails from these senders create new issues (empty = any sender)
MAIL_NOTIFICATION_SENDERS=soc-notify@example.com

# --- Polling -----------------------------------------------------------------
POLL_INTERVAL_SECONDS=120
POLL_SOAR_ENABLED=true
POLL_MAIL_ENABLED=true
POLL_MAX_RESULTS=50

# --- Sync rules ----------------------------------------------------------------
MASTER_SYSTEM=jira
CLOSED_STATUS_NAMES=Done,Closed,Resolved

RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE=5
RETRY_BACKOFF_MAX=60

# --- State and cache -------------------------------------------------------------
DATABASE_URL=sqlite:///data/sync_engine.db
CACHE_ENABLED=true
CACHE_MAX_DB_BYTES=125829120
CACHE_MAX_SEEN_ROWS=250000
CACHE_PRUNE_BATCH_SIZE=2000
CACHE_PRUNE_EVERY_N_WRITES=500

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=sync_engine.log
LOG_BACKUP_DAYS=30
LOG_MAX_FOLDER_BYTES=2147483648
LOG_TRUNCATE_LENGTH=1500
LOG_PRUNE_CHECK_INTERVAL_SECONDS=300
